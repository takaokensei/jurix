{"document_key": "sha256:121b46b52e9485d44311359a4164e167d059e59bd8bde1ec949387eade416897", "edition": "diario", "events_exhaustive": false, "excerpt_mapping": [{"excerpt_end": 170, "excerpt_start": 0, "source_end": 95730, "source_start": 95560}], "identity_evidence": {"end": 75952, "origin_text_sha256": "efee7f9c77d61e3dd4b94c5ab9daafaf2ce62effc212b6d04196ff466eb4b040", "quote": "LEI PROMULGADA Nº 0275/2009\nDispõe sobre a regulamentação das calçadas no Município de Natal e dá outras providências.\nO PRESIDENTE DA CÂMARA MUNICIPAL DO NATAL, no uso das atribuições que lhe são conferidas \npelo Artigo 22, Inciso XVI, da Lei Orgânica do Município do Natal, PROMULGA a seguinte Lei:\nCapítulo I - Das Calçadas\nArt. 1º - Esta Lei disc", "start": 75602}, "norma_key": "BR-RN-NATAL|lei_promulgada|275|2009", "origin_extractor_version": "pymupdf-1.28.2", "origin_text_sha256": "efee7f9c77d61e3dd4b94c5ab9daafaf2ce62effc212b6d04196ff466eb4b040", "origin_text_version": "native_pages_v1", "qa_document_id": null, "reviewed_devices": [{"device_key": "art:21", "extent": "device_text", "pages": [9]}], "unit_id": "n10", "whole_norm_reviewed": false}
