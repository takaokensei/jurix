{"id": "cpc-219-001", "question": "Na contagem de prazo processual civil estabelecido em dias, quais dias devem ser computados?", "source": {"law": "Lei 13.105/2015", "article": "219", "url": "https://planalto.gov.br/ccivil_03/_ato2015-2018/2015/lei/l13105.htm"}, "expected_citations": ["Lei 13.105/2015", "Art. 219"], "must_contain_any": [["dias úteis", "dias uteis"]], "category": "procedural_deadline"}
