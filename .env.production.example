# Required production secrets/configuration
POSTGRES_DB=jurix
POSTGRES_USER=jurix_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=jurix.example.org
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional production hardening
READINESS_REQUIRE_OLLAMA=true
SAPL_INCREMENTAL_MAX_PAGES=20
SAPL_FULL_SYNC_MAX_PAGES=1000
SAPL_SYNC_LEASE_SECONDS=900
SAPL_OCR_MAX_PAGES=200

# Local storage is persistent only on a single Compose host because /app/data
# is backed by the named jurix_data volume. Prefer S3/MinIO for multi-host deployments.
JURIX_ATTACHMENT_ROOT=/app/data/chat_attachments
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=100

# Bind the application to localhost by default when a reverse proxy is used.
JURIX_BIND_ADDRESS=127.0.0.1
JURIX_HTTP_PORT=8000
