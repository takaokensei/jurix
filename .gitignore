# Git ignore patterns for Jurix project
# Excludes build artifacts, virtual environments, and sensitive data

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/

# Environment
.env
.env.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Data
data/raw/
data/logs/
# Downloaded/derived data only. A bare '*.pdf' / '*.json' also hid legitimate files anywhere in
# the tree (test fixtures, package.json, VS Code settings, docs).
/data/**/*.pdf
/data/**/*.json

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/


# Frontend test dependencies (tests/js)
tests/js/node_modules/
