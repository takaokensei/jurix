# Database Configuration
POSTGRES_DB=jurix
POSTGRES_USER=jurix_user
POSTGRES_PASSWORD=jurix_pass_dev
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://jurix_user:jurix_pass_dev@db:5432/jurix

# Redis & Cache Configuration
REDIS_URL=redis://redis:6379/0

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
# Local development only. Defaults to False; production must set a private
# DJANGO_SECRET_KEY (the app refuses to start without one when DEBUG is off).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- LLM endpoint limits (see src/apps/legislation/api_limits.py) ---
# Extra models clients may request, comma-separated (OLLAMA_MODEL is always allowed)
# OLLAMA_ALLOWED_MODELS=llama3,mistral
LLM_MAX_K=20
LLM_MAX_QUESTION_LENGTH=2000
LLM_RATE_LIMIT_REQUESTS=20
LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies in front of the app. Behind one nginx/ALB set 1, otherwise every
# visitor shares the proxy IP and a single rate-limit bucket. 0 = use REMOTE_ADDR.
NUM_PROXIES=0

# --- PIBIC / corpus municipal SAPL ---
SAPL_CORPUS_TARGET=300
SAPL_PILOT_SIZE=20
SAPL_CORPUS_START_YEAR=2000
SAPL_CORPUS_REQUEST_DELAY_SECONDS=0.2

# --- HTTPS hardening (effective when DEBUG is off) ---

# Secure cookies default to on; set to False only if you still serve plain HTTP.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=https://jurix.example.org
# TRUST_X_FORWARDED_PROTO=False   # True only behind a proxy that sets X-Forwarded-Proto
